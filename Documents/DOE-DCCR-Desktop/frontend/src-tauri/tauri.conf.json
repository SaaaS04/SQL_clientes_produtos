{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DOE-DCCR",
  "version": "0.1.0",
  "identifier": "br.unit.itp.doedccr",
  "build": {
    "frontendDist": "../dist/doe-dccr-ui/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DOE-DCCR",
        "width": 1360,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Planejamento experimental DCCR e superficie de resposta",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
